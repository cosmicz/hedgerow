# Local app root only. Never commit the populated .env or put this in browser code.
OPENROUTER_API_KEY=
SENSO_API_KEY=
# Explicit opt-in for bounded synthetic-only evaluation; disabled by default.
RG_MODEL_LIVE=0
RG_AGENT_LIVE=0
# Optional local audit stores; leave blank for visibly labelled local fallback.
RG_CLICKHOUSE_URL=
RG_MONGO_URI=
RG_SEMGREP_SCAN=0
# Fixed owned OpenWrt container only; never a household or venue router.
RG_ROUTER_LAB=0
# Exact browser origin; set 8788 for the documented Pi SSH-forward setup.
RG_UI_ORIGIN=http://127.0.0.1:8787
RG_DEPLOYMENT=mac-lab
